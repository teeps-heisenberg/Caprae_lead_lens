# Local defaults work with no changes. Copy to .env to override.
DATABASE_URL=sqlite:///./leadlens.db
# auto = bundled demo site when one exists for the domain, otherwise the real website (recommended).
# fixture = bundled sites only (tests, offline). live = real websites only.
ENRICH_MODE=auto
# none | gemini
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_DAYS=7
